# Keep this file server-side. Never put the OpenAI key in the Android app.
OPENAI_API_KEY=
OPENAI_MODEL=chat-latest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_TOKEN=
HOST=127.0.0.1
PORT=8787
MAX_DAILY_REQUESTS=60
MAX_CONCURRENT_RUNS=3
# For the supplied Docker Compose deployment:
DOMAIN=
